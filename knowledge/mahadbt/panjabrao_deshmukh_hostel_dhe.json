      },
      "ask_if_unknown": {
        "field_key": "domicile_state"
      }
    },
    {
      "id": "income_8_lakh",
      "text": {
        "en": "Family annual income ≤ ₹8,00,000 (professional courses)",
        "mr": "",
        "hi": ""
      },
      "logic": {
        "<=": [
          {
            "var": "profile.annual_family_income"
          },
          800000
        ]
      },
      "applies_if": {
        "==": [
          {
            "var": "answers.professional_course"
          },
          "yes"
        ]
      },
      "applies_note": {
        "en": "Only for professional courses",
        "mr": "फक्त व्यावसायिक अभ्यासक्रमांसाठी",
