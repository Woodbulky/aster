  "summary": {
    "en": "Yearly hostel / living allowance for general-category and SEBC students who live away from home (hostel, PG or rented room).",
    "mr": "",
    "hi": ""
  },
  "criteria": [
    {
      "id": "domicile_maharashtra",
      "text": {
        "en": "Domicile of Maharashtra",
        "mr": "",
        "hi": ""
      },
      "logic": {
        "==": [
          {
            "var": "profile.domicile_state"
          },
          "Maharashtra"
        ]
      },
      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51A1FA3AA7E67D54CF402FD88D88C64949C41EC3238C8545A71",
        "quote": "Applicant should be Domicile of Maharashtra."
      },
      "ask_if_unknown": {
        "field_key": "domicile_state"
      }
    },
    {
      "id": "income_8_lakh",
      "text": {
        "en": "Family annual income ≤ ₹8,00,000 (professional courses)",
        "mr": "",
        "hi": ""
      },
      "logic": {
        "<=": [
          {
            "var": "profile.annual_family_income"
          },
          800000
        ]
      },
      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51A1FA3AA7E67D54CF402FD88D88C64949C41EC3238C8545A71",
        "quote": "total annual income of family/ Guardian should not be more than 8.lakh"
      },
      "ask_if_unknown": {
        "field_key": "annual_family_income"
      }
    },
    {
      "id": "income_1_lakh_non_prof",
      "text": {
        "en": "Non-professional courses: family income ≤ ₹1,00,000",
        "mr": "",
        "hi": ""
      },
      "logic": null,
      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51A1FA3AA7E67D54CF402FD88D88C64949C41EC3238C8545A71",
        "quote": "For Non Professional Courses, applicant should have upto 1 lakh family Annual Income."
      }
    },
    {
      "id": "general_or_sebc",
      "text": {
        "en": "Admission under the general category or SEBC",
        "mr": "",
        "hi": ""
      },
      "logic": {
        "in": [
          {
            "var": "profile.category"
          },
          [
            "Open",
            "EWS",
            "SEBC"
          ]
        ]
      },
      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51A1FA3AA7E67D54CF402FD88D88C64949C41EC3238C8545A71",
        "quote": "Candidates are eligible those who have taken an admission under general category and SEBC Category."
      },
      "ask_if_unknown": {
        "field_key": "category"
      }
    },
    {
      "id": "hosteller",
