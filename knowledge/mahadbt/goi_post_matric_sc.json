    },
    {
      "id": "professional_course",
      "text": {
        "en": "Is your course a professional course (as the scheme defines it)?",
        "mr": "तुमचा अभ्यासक्रम (योजनेनुसार) व्यावसायिक अभ्यासक्रम आहे का?",
        "hi": "क्या आपका कोर्स (योजना के अनुसार) व्यावसायिक कोर्स है?"
