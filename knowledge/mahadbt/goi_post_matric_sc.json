      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51ACE99921E698B1EE85995B38445F14746E1B0DD7E66FFF88B",
        "quote": "Only 2 professional Courses are allowed."
      }
    },
    {
      "id": "professional_courses_availed",
      "text": {
        "en": "For how many professional courses have you already received this scholarship?",
        "mr": "तुम्हाला ही शिष्यवृत्ती आधीच किती व्यावसायिक अभ्यासक्रमांसाठी मिळाली आहे?",
        "hi": "आपको यह छात्रवृत्ति पहले कितने व्यावसायिक कोर्स के लिए मिल चुकी है?"
