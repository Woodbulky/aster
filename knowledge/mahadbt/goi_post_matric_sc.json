  "summary": {
    "en": "Tuition fees, exam fees and a monthly maintenance allowance for SC / Neo-Buddhist students after 10th, with family income up to ₹2.5 lakh.",
    "mr": "",
    "hi": ""
  },
  "criteria": [
    {
      "id": "sc_category",
      "text": {
        "en": "Belongs to Scheduled Caste or Navbouddha",
        "mr": "",
        "hi": ""
      },
      "logic": {
        "==": [
          {
            "var": "profile.category"
          },
          "SC"
        ]
      },
      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51ACE99921E698B1EE85995B38445F14746E1B0DD7E66FFF88B",
        "quote": "Student category shall belong to Scheduled caste or Navbouddha"
      },
      "ask_if_unknown": {
        "field_key": "category"
      }
    },
    {
      "id": "income_2_5_lakh",
      "text": {
        "en": "Parents' annual income ≤ ₹2,50,000",
        "mr": "",
        "hi": ""
      },
      "logic": {
        "<=": [
          {
            "var": "profile.annual_family_income"
          },
          250000
        ]
      },
      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51ACE99921E698B1EE85995B38445F14746E1B0DD7E66FFF88B",
        "quote": "The parents/Guardian annual income shall be less than or equal to Rs. 2,50,000."
      },
      "ask_if_unknown": {
        "field_key": "annual_family_income"
      }
    },
    {
      "id": "domicile_maharashtra",
      "text": {
        "en": "Resident of Maharashtra",
        "mr": "",
        "hi": ""
      },
      "logic": {
        "==": [
          {
            "var": "profile.domicile_state"
          },
          "Maharashtra"
        ]
      },
      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51ACE99921E698B1EE85995B38445F14746E1B0DD7E66FFF88B",
        "quote": "Student shall belong to resident of Maharashtra"
      },
      "ask_if_unknown": {
        "field_key": "domicile_state"
      }
    },
    {
      "id": "passed_ssc",
      "text": {
        "en": "Passed SSC (10th) or equivalent",
        "mr": "",
        "hi": ""
      },
      "logic": {
        "or": [
          {
            "!!": [
              {
                "var": "profile.ssc_year"
              }
            ]
          },
          {
            "!!": [
              {
                "var": "profile.entry_qualification"
              }
            ]
          }
        ]
      },
      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51ACE99921E698B1EE85995B38445F14746E1B0DD7E66FFF88B",
        "quote": "Student should be passes SSC/equivalent Matric."
      }
    },
    {
      "id": "max_two_professional",
      "text": {
        "en": "Only 2 professional courses are allowed",
        "mr": "",
        "hi": ""
      },
      "logic": {
        "in": [
          {
            "var": "answers.professional_courses_availed"
          },
          [
            "0",
            "1"
          ]
        ]
      },
      "applies_if": {
        "==": [
          {
            "var": "answers.professional_course"
          },
          "yes"
        ]
      },
      "applies_note": {
        "en": "Only for professional courses",
        "mr": "फक्त व्यावसायिक अभ्यासक्रमांसाठी",
        "hi": "सिर्फ़ व्यावसायिक कोर्स के लिए"
      },
      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51ACE99921E698B1EE85995B38445F14746E1B0DD7E66FFF88B",
        "quote": "Only 2 professional Courses are allowed."
      }
    }
  ],
