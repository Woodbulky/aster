  "summary": {
    "en": "Tuition and exam fee support for general-category and SEBC students in Directorate of Higher Education courses, with family income up to ₹8 lakh.",
    "mr": "",
    "hi": ""
  },
  "criteria": [
    {
      "id": "domicile_maharashtra",
      "text": {
        "en": "Domicile of Maharashtra",
        "mr": "",
        "hi": ""
      },
      "logic": {
        "==": [
          {
            "var": "profile.domicile_state"
          },
          "Maharashtra"
        ]
      },
      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51AA86467549C6E0CFFDFD61E992C8610ED352EC9DEF886C9CD",
        "quote": "Applicant should be Domicile of Maharashtra"
      },
      "ask_if_unknown": {
        "field_key": "domicile_state"
      }
    },
    {
      "id": "income_8_lakh",
      "text": {
        "en": "Family annual income ≤ ₹8,00,000",
        "mr": "",
        "hi": ""
      },
      "logic": {
        "<=": [
          {
            "var": "profile.annual_family_income"
          },
          800000
        ]
      },
      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51AA86467549C6E0CFFDFD61E992C8610ED352EC9DEF886C9CD",
        "quote": "Family annual income limit is upto Rs. 8.00 lakh."
      },
      "ask_if_unknown": {
        "field_key": "annual_family_income"
      }
    },
    {
      "id": "general_or_sebc",
      "text": {
        "en": "Admission under the general category or SEBC",
        "mr": "",
        "hi": ""
      },
      "logic": {
        "or": [
          {
            "in": [
              {
                "var": "profile.category"
              },
              [
                "Open",
                "EWS",
                "SEBC"
              ]
            ]
          },
          {
            "in": [
              {
                "var": "answers.admission_category"
              },
              [
                "open",
                "SEBC"
              ]
            ]
          }
        ]
      },
      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51AA86467549C6E0CFFDFD61E992C8610ED352EC9DEF886C9CD",
        "quote": "Candidates are eligible those who have taken an admission under general category and SEBC Category."
      }
    },
    {
      "id": "first_two_children",
      "text": {
        "en": "Only the first two children of a family",
        "mr": "",
        "hi": ""
      },
      "logic": {
        "==": [
          {
            "var": "answers.first_two_children"
          },
          "yes"
        ]
      },
      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51AA86467549C6E0CFFDFD61E992C8610ED352EC9DEF886C9CD",
        "quote": "As per Government Resolution first two children are eligible for scheme."
      }
    },
    {
      "id": "no_other_scholarship",
      "text": {
        "en": "Not taking any other scholarship or stipend",
        "mr": "",
        "hi": ""
      },
      "logic": {
        "==": [
          {
            "var": "answers.other_scholarship"
          },
          "no"
        ]
      },
      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51AA86467549C6E0CFFDFD61E992C8610ED352EC9DEF886C9CD",
        "quote": "Applicant should not avail any other scholarship or stipend."
      }
    },
    {
      "id": "not_distance",
      "text": {
        "en": "Not in distance, virtual or part-time education",
        "mr": "",
        "hi": ""
      },
      "logic": {
        "==": [
          {
            "var": "profile.course_mode"
          },
          "regular"
        ]
      },
      "source": {
        "url": "https://mahadbt.maharashtra.gov.in/SchemeData/SchemeData?str=E9DDFA703C38E51AA86467549C6E0CFFDFD61E992C8610ED352EC9DEF886C9CD",
        "quote": "Students are not eligible who has taken an admission in Distance Education, virtual learning and part time courses."
      },
      "ask_if_unknown": {
        "field_key": "course_mode"
      }
    }
  ],
