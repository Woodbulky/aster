# ---- app ----
APP_ENV=dev
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# ---- supabase (secret/service key: BACKEND ONLY) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# ---- LLM routing: gpu = Kaggle gateway first, fallback second; fallback = skip GPU (dev, saves Kaggle hours) ----
LLM_PRIMARY=gpu

# ---- GPU worker (Kaggle gateway) ----
GATEWAY_TOKEN=
GPU_WORKER_NAME=kaggle-main
GPU_STALE_SECONDS=180
GPU_URL_OVERRIDE=                 # optional: force a gateway URL, skips Supabase discovery
BRAIN_MODEL=qwen3-vl:8b-instruct

# ---- fallback brain: any OpenAI-compatible, vision-capable model ----
FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_API_KEY=                # secret: set in backend/.env and Render env, never here. Comma-separated keys from DIFFERENT Groq orgs: each org has its own 8k tokens/min, 200k/day; a 429 rotates to the next key
FALLBACK_LLM_MODEL=<vision model id from the models page>
SCREEN_READER_PRIMARY=fallback     # form filling: who reads a new page first (fallback = Groq ~1.5-3 s; gpu = T4 ~10-13 s)
BRAIN_PRIMARY=fallback             # conversation turns: fallback = Groq first (~2 s), gpu = T4 first (~5 s); documents keep LLM_PRIMARY

# ---- speech: Sarvam (docs.sarvam.ai); STT falls back to the Kaggle /asr (hi/mr) ----
SARVAM_API_KEY=                      # secret: backend/.env and Render env only
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE_MR=priya
SARVAM_TTS_VOICE_HI=priya
SARVAM_TTS_VOICE_EN=priya
STT_TIMEOUT_S=6
TTS_TIMEOUT_S=5

# ---- research ----
TAVILY_API_KEY=
# Context.dev (search fallback + scraping pages our fetcher can't read); empty = off
CONTEXT_DEV_API_KEY=
# timeouts/limits default in config.py (search 10 s, fetch 10 s / 5 MB, PDF 15 pages, OCR 30 s)
# Dev only: offer draft knowledge packs (cards say DRAFT). Ignored when APP_ENV=prod.
PACKS_INCLUDE_DRAFT=false
