# ---- app ----
APP_ENV=dev
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# ---- supabase (secret/service key: BACKEND ONLY) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# ---- GPU worker (Kaggle gateway) ----
GATEWAY_TOKEN=
GPU_WORKER_NAME=kaggle-main
GPU_STALE_SECONDS=180
GPU_URL_OVERRIDE=                 # optional: force a gateway URL, skips Supabase discovery
BRAIN_MODEL=qwen3-vl:8b

# ---- fallback brain: any OpenAI-compatible, vision-capable model ----
FALLBACK_LLM_BASE_URL=
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_MODEL=

# ---- speech (fill model/voice names from current vendor docs) ----
SARVAM_API_KEY=
SARVAM_STT_MODEL=
SARVAM_TTS_MODEL=
SARVAM_TTS_VOICE_MR=
SARVAM_TTS_VOICE_HI=
SARVAM_TTS_VOICE_EN=
BHASHINI_USER_ID=
BHASHINI_ULCA_API_KEY=

# ---- research ----
TAVILY_API_KEY=
