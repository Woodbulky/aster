# ---- app ----
APP_ENV=dev
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000

# ---- supabase (secret/service key: BACKEND ONLY) ----
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=

# ---- LLM routing: gpu = Kaggle gateway first, fallback second; fallback = skip GPU (dev, saves Kaggle hours) ----
LLM_PRIMARY=gpu

# ---- GPU worker (Kaggle gateway) ----
GATEWAY_TOKEN=
GPU_WORKER_NAME=kaggle-main
GPU_STALE_SECONDS=180
GPU_URL_OVERRIDE=                 # optional: force a gateway URL, skips Supabase discovery
BRAIN_MODEL=qwen3-vl:8b-instruct

# ---- fallback brain: any OpenAI-compatible, vision-capable model ----
FALLBACK_LLM_BASE_URL=https://api.groq.com/openai/v1
FALLBACK_LLM_API_KEY=                # secret: set in backend/.env and Render env, never here
FALLBACK_LLM_MODEL=<vision model id from the models page>

# ---- speech: Sarvam (docs.sarvam.ai); STT falls back to the Kaggle /asr (hi/mr) ----
SARVAM_API_KEY=                      # secret: backend/.env and Render env only
SARVAM_STT_MODEL=saaras:v4
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_TTS_VOICE_MR=priya
SARVAM_TTS_VOICE_HI=priya
SARVAM_TTS_VOICE_EN=priya
STT_TIMEOUT_S=6
TTS_TIMEOUT_S=5

# ---- research ----
TAVILY_API_KEY=
