NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # anon / publishable key (safe for browser)
NEXT_PUBLIC_API_URL=                    # https://api.<domain> with a named tunnel; empty = discover from public_endpoints
NEXT_PUBLIC_WS_URL=                     # empty = derived from API URL (https→wss)
