NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=          # anon / publishable key (safe for browser)
# Local dev: use http://127.0.0.1:8000, not localhost. Browsers send every localhost cookie (any port)
# with the WS handshake, and uvicorn hangs silently on a Cookie header over 8 KB.
NEXT_PUBLIC_API_URL=                    # https://<service>.onrender.com; empty = discover from public_endpoints (phone quick-tunnel backup)
NEXT_PUBLIC_WS_URL=                     # empty = derived from API URL (https→wss)
